<!-- voice input API keys must never leave the device -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="voice_api_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="voice_api_keys.xml" />
    </device-transfer>
</data-extraction-rules>
